# Example Terraform variables file
# Copy this file to terraform.tfvars and update with your values

aws_region = "us-east-1"
project_name = "wordpress-swarm"
environment = "production"

# Network configuration
vpc_cidr = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

# CRITICAL SECURITY REQUIREMENT: You MUST update these CIDRs before deployment!
#
# To find your current IP: curl -4 ifconfig.me
# For a single IP: ["YOUR.IP.ADDRESS.HERE/32"]
# For a network range: ["203.0.113.0/24"]
# For multiple IPs: ["1.2.3.4/32", "5.6.7.8/32"]
#
# SSH Access - Restrict to your office/VPN/home IP only
allowed_ssh_cidrs = ["YOUR.IP.ADDRESS.HERE/32"]  # REPLACE THIS - Required for SSH access

# NOTE: SSH keys are auto-generated by Terraform
# The private key will be saved in Terraform state
# You can retrieve it with: terraform output -raw private_key > swarm-key.pem
# No need to provide ssh_public_key unless you want to use your existing key

# Instance configuration
manager_instance_type = "t3.medium"
worker_instance_type = "t3.medium"
worker_count = 2

# Storage configuration (GB)
manager_root_volume_size = 30
worker_root_volume_size = 30
